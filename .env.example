# Node Configuration
NODE_ID=node-1
NODE_HOST=0.0.0.0
NODE_PORT=8001

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Cluster Configuration
CLUSTER_NODES=node-1:8001,node-2:8002,node-3:8003

# Geo-Distributed Configuration
NODE_REGION=ap-southeast

# Security
ENABLE_TLS=false
ENABLE_RBAC=false
SECRET_KEY=change-me-in-production

# Logging
LOG_LEVEL=INFO
